// Dyed twine, mirrors game:itemtypes/resource/flaxtwine.json (shape, ground-storage)
// and game:itemtypes/resource/cloth.json (dye-related attributes/handbook grouping).
// Plain twine stays game:flaxtwine; this only adds the mordant + dyed variants.
{
	code: "twine",
	shape: { base: "game:item/resource/flaxtwine" },
	behaviors: [
		// Loom brush size (F: 1, 2, 4, 8 cells per click), src/Loom/CollectibleBehaviorLoomBrush.cs.
		{ name: "actailor.LoomBrush" },
		{ name: "GroundStorable",
			properties: {
				layout: 'Stacking',
				placeRemoveSound: 'sounds/block/plant',
				stackingModel: 'game:item/resource/flaxtwine-pile',
				modelItemsToStackSizeRatio: 5,
				stackingCapacity: 17,
				transferQuantity: 1,
				bulkTransferQuantity: 6,
				collisionBox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.16, z2: 1 },
				cbScaleYByLayer: 0.2
			}
		}
	],
	attributes: {
		clothingRepairStrength: 0.1,
		displaycaseable: true,
		shelvable: true,
		displayable: {
			shelf: {
				size: { width: 8, height: 3, length: 6 }
			}
		},
		onDisplayTransform: {
			rotation: { x: 0, y: -90, z: 0 },
			origin: { x: 0.5, y: 0, z: 0.5 },
			scale: 0.55
		},
		groundStorageTransform: {
			translation: { x: 0, y: -0.1, z: 0 },
			rotation: { x: 0, y: 30, z: 0 },
			scale: 0.8
		},
		handbook: {
			groupBy: ["twine-*"]
		},
		inContainerTextureByType: {
			"*-gold": { base: "game:block/metal/ingot/gold" },
			"*": { base: "game:block/cloth/linen/{color}" }
		}
	},
	// Average colour of the matching game:block/cloth/linen/{color} texture, sampled with
	// scripts/sample_texture_color.py. Read by the weaving/loom lane to tint pattern pixels.
	attributesByType: {
		"*-mordant": { tailorColor: "#827a60" },
		"*-blue": { tailorColor: "#476b8f" },
		"*-red": { tailorColor: "#a0493c" },
		"*-yellow": { tailorColor: "#9e7f19" },
		"*-green": { tailorColor: "#659055" },
		"*-purple": { tailorColor: "#584a72" },
		"*-pink": { tailorColor: "#a05084" },
		"*-orange": { tailorColor: "#ab6129" },
		"*-brown": { tailorColor: "#644335" },
		"*-gray": { tailorColor: "#717074" },
		"*-black": { tailorColor: "#333333" },
		"*-white": { tailorColor: "#d2d1d4" },
		// Golden twine (creative only, no recipe yet): average colour of game:block/metal/ingot/gold.
		"*-gold": { tailorColor: "#e8af2c" }
	},
	variantgroups: [
		{ code: "color", states: ["mordant", "blue", "red", "yellow", "green", "purple", "pink", "orange", "brown", "gray", "black", "white", "gold"] }
	],
	creativeinventory: { "general": ["*"], "items": ["*"] },
	maxstacksize: 32,
	materialDensity: 210,
	texturesByType: {
		"*-gold": {
			"linen": { base: "game:block/metal/ingot/gold" }
		},
		"*": {
			// flaxtwine shape (and its ground pile) use texture key "linen"
			"linen": { base: "game:block/cloth/linen/{color}" }
		}
	},
	guiTransform: {
		rotation: { x: 1, y: 43, z: -37 },
		origin: { x: 0.5, y: 0.1, z: 0.5 },
		scale: 2.41
	},
	tpHandTransform: {
		translation: { x: -1, y: -1, z: -1.3 },
		rotation: { x: -93, y: -3, z: -5 },
		scale: 0.51
	},
	groundTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: 0, y: 0, z: 0 },
		origin: { x: 0.3, y: 0.0, z: 0.5299 },
		scale: 4
	}
}
