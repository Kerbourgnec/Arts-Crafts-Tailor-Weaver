	selectionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.0625, z2: 1 },
	collisionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.0625, z2: 1 },
	combustibleProps: { burnTemperature: 400, burnDuration: 10 },
	sounds: {
		place: "game:block/cloth",
		break: "game:block/cloth",
		hit: "game:block/cloth",
		walk: "game:walk/cloth"
	},
	materialDensity: 200,
	guiTransform: {
