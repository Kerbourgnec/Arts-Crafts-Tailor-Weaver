// Small carpet (1x1, thin and slightly inset like vanilla carpets, lane/linen-output) from one woven cloth of any square
// size, or woven on the loom as an N x N carpet; shows its pattern (block entity actailor.Patterned).
// Orientable like the loom (variant = direction the player looked): the pattern reads as on the loom from the
// weaver's seat (first woven row nearest to the player, cell 0 on their right). Needs solid ground.
{
	code: "wovencarpet-small",
	class: "actailor.BlockPatterned",
	entityClass: "actailor.Patterned",
	variantgroups: [
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],
	behaviors: [{ name: "HorizontalOrientable" }],
	attributes: {
		patternKeys: ["pattern"],
		dropCode: "actailor:wovencarpet-small-north",
		needsFloor: true,
		handbook: { groupBy: ["wovencarpet-small-*"] }
	},
	shapeByType: {
		"*-north": { base: "actailor:block/decor/carpet-small", rotateY: 180 },
		"*-east": { base: "actailor:block/decor/carpet-small", rotateY: 90 },
		"*-south": { base: "actailor:block/decor/carpet-small", rotateY: 0 },
		"*-west": { base: "actailor:block/decor/carpet-small", rotateY: 270 }
	},
	shapeInventory: { base: "actailor:block/decor/carpet-small", rotateY: 0 },
	textures: {
		pattern: { base: "game:block/cloth/linen/normal1" }
	},
	creativeinventory: { general: ["*-north"], decorative: ["*-north"] },
	drawtype: "json",
	blockmaterial: "Cloth",
