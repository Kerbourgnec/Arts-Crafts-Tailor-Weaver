// Large carpet (1x2 blocks, lane/linen-output; replaces the 2x2 of lane/cloth-decor): woven on the loom as one
// N x 2N cloth (product "large carpet"), or crafted from two woven cloths (C,C: top = far tile). tile0 = far block
// (cloth rows N..2N-1), tile1 = near block (rows 0..N-1): the first woven row lies nearest to the player, as on the loom.
// Placed as a 1x2x1 multiblock: the clicked block is the near end, the carpet extends away from the player.
// Thin and slightly inset like vanilla carpets (vanilla: flat planes; medium carpet 1 x ~1.6 blocks visible, verified).
// Fillers reuse the controller's boxes (offsetHitboxes).
{
	code: "wovencarpet-large",
	class: "actailor.BlockPatterned",
	entityClass: "actailor.Patterned",
	variantgroups: [
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],
	behaviorsByType: {
		"*-north": [
			{ name: "HorizontalOrientable" },
			{ name: "Multiblock", properties: { sizex: 1, sizey: 1, sizez: 2, cposition: { x: 0, y: 0, z: 1 }, offsetHitboxes: true } }
		],
		"*-east": [
			{ name: "HorizontalOrientable" },
			{ name: "Multiblock", properties: { sizex: 2, sizey: 1, sizez: 1, cposition: { x: 0, y: 0, z: 0 }, offsetHitboxes: true } }
		],
		"*-south": [
			{ name: "HorizontalOrientable" },
			{ name: "Multiblock", properties: { sizex: 1, sizey: 1, sizez: 2, cposition: { x: 0, y: 0, z: 0 }, offsetHitboxes: true } }
		],
		"*-west": [
			{ name: "HorizontalOrientable" },
			{ name: "Multiblock", properties: { sizex: 2, sizey: 1, sizez: 1, cposition: { x: 1, y: 0, z: 0 }, offsetHitboxes: true } }
		]
	},
	attributes: {
		patternKeys: ["tile0", "tile1"],
		// One N x 2N carpet cloth (cut from the loom): its two N x N halves, [cell column, row] each: tile0 (far) = rows N..2N-1.
		splitCloth: { cols: 1, rows: 2, tiles: [[0, 1], [0, 0]] },
		dropCode: "actailor:wovencarpet-large-north",
		needsFloor: true,
		handbook: { groupBy: ["wovencarpet-large-*"] }
	},
	shapeByType: {
		"*-north": { base: "actailor:block/decor/carpet-large", rotateY: 180 },
		"*-east": { base: "actailor:block/decor/carpet-large", rotateY: 90 },
		"*-south": { base: "actailor:block/decor/carpet-large", rotateY: 0 },
		"*-west": { base: "actailor:block/decor/carpet-large", rotateY: 270 }
	},
	shapeInventory: { base: "actailor:block/decor/carpet-large-inventory", rotateY: 0 },
	textures: {
		tile0: { base: "game:block/cloth/linen/normal1" },
		tile1: { base: "game:block/cloth/linen/normal1" }
	},
	creativeinventory: { general: ["*-north"], decorative: ["*-north"] },
	drawtype: "json",
	blockmaterial: "Cloth",
	sidesolid: { all: false },
	sideopaque: { all: false },
	emitSideAo: { all: false },
	lightAbsorption: 0,
	replaceable: 5200,
	resistance: 0.5,
	vertexFlags: { zOffset: 5 },
	// Whole 1x2 footprint, rotated around the controller block centre like the shape.
	selectionboxByType: {
		"*-north": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.0625, z2: 2, rotateY: 180 },
		"*-east": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.0625, z2: 2, rotateY: 90 },
		"*-south": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.0625, z2: 2 },
		"*-west": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.0625, z2: 2, rotateY: 270 }
	},
	collisionboxByType: {
		"*-north": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.0625, z2: 2, rotateY: 180 },
		"*-east": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.0625, z2: 2, rotateY: 90 },
		"*-south": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.0625, z2: 2 },
		"*-west": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.0625, z2: 2, rotateY: 270 }
	},
	combustibleProps: { burnTemperature: 400, burnDuration: 20 },
	sounds: {
		place: "game:block/cloth",
		break: "game:block/cloth",
		hit: "game:block/cloth",
		walk: "game:walk/cloth"
	},
	materialDensity: 200,
	guiTransform: {
		translation: { x: 0, y: 3, z: 0 },
		origin: { x: 0.5, y: 0.0625, z: 0.5 }
	},
	groundTransform: {
		rotation: { x: 0, y: -45, z: 0 },
		origin: { x: 0.5, y: -0.02, z: 0.5 },
		scale: 1.5
	},
	tpHandTransform: {
		translation: { x: -1.7, y: 0.1, z: -1.5 },
		rotation: { x: -46, y: 0, z: -2 },
		origin: { x: 0.5, y: 0, z: 0.5 }
	}
}
