		{ "code": "game:linen-diamond-*", "family": "cloth", "texture": "game:block/cloth/linen/diamond1", "color": "#cfc4a8" },
		{ "code": "game:linen-normal-*", "family": "cloth", "texture": "game:block/cloth/linen/normal1", "color": "#cfc4a8" },
