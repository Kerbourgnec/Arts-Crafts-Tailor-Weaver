		{ "code": "game:bone", "family": "bone", "texture": "game:block/creature/bone", "color": "#e0d8c0" },
		{ "code": "game:bone-tiny", "family": "bone", "texture": "game:block/creature/bonesrotten", "color": "#d8ccb0" },
		{ "code": "game:bone-fish", "family": "bone", "texture": "game:block/creature/bonehumanoid", "color": "#e0d8c0" },
		// Wood: sticks and boards (planks).
		{ "code": "game:stick", "family": "wood", "texture": "game:block/wood/debarked/oak", "color": "#9a7a50" },
