// Garment recipe (docs/garments.md). Item actailor:garment-vest is generated by scripts/garment-items.py.
// Model: our anisotropy-free copy (scripts/garment-shapes.py) of the vanilla over-garment short-sleeve coat (what the vanilla fur-lined vest uses), sleeves and skirt flaps
// hidden: a waist-length vest over a shirt. Buttons: three small cuboids from our generated extra shape
// (scripts/garment-extra-shapes.py, shapes/entity/garment/vest-buttons.json), down the front of the torso.
// Texture 56x88 texels = 28x44 shape units (2 texels per unit, like vanilla).
{
	code: "vest",
	order: 20,
	dressType: "upperbodyover",
	warmth: 1,
	shape: "actailor:entity/garment/base/upperbodyover/shortsleeve",
	extraShape: "actailor:entity/garment/vest-buttons",
	hideElements: ["UpperArmROrigin", "UpperArmLorigin", "UpperFootLorigin", "UpperFootRorigin", "coatFrontTile", "coatBackTile"],
	textureKey: "uover",
	textureWidth: 56,
	textureHeight: 88,
	parts: [
		// Torso (upper + lower torso boxes: sides, shoulders, bottom). Woven or vanilla cloth only.
		{ code: "body", regions: [[12, 0, 24, 11], [2, 11, 46, 31], [0, 63, 12, 73], [38, 63, 50, 73]], materials: ["cloth"] },
		// Neck trim (vanilla element hidecollar): cloth or a pelt (fur collar).
		{ code: "trim", regions: [[26, 5, 50, 9]], materials: ["cloth", "pelt"] },
		// Buttons: bone, wood or metal; left empty, the button cuboids are not part of the model.
		{ code: "buttons", regions: [[26, 0, 29, 1]], materials: ["wood", "metal", "bone"], elements: ["vestbutton1", "vestbutton2", "vestbutton3"], options: [{ code: "none" }, { code: "buttons" }] }
	],
	// Inner "Blackout" box of the coat shape (seen through the neck opening): dark lining.
	fixed: [ { rect: [0, 0, 10, 10], color: "#1c1611" } ],
	itemType: {
		textures: {
			seraph: { base: "game:block/transparent" },
			uover: { base: "game:entity/humanoid/seraphclothes/upperbodyover/furlinedvest" }
		},
		guiTransform: {
			rotation: { x: -180, y: -66, z: 18 },
			origin: { x: 0.2, y: 1.28, z: 0.4 },
			scale: 1.8
		}
	}
}
