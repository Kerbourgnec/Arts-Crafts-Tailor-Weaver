// Garment recipe (docs/garments.md). Item actailor:garment-badge is generated by scripts/garment-items.py.
// Embroidered badge pinned on the chest, with an optional hanging ribbon. Model: our anisotropy-free copy
// (scripts/garment-shapes.py) of the vanilla blue seal (emblem/blue-seal): pendant = badge, ribbon (+ its tips) below.
// Texture 32x32 texels = 16x16 shape units; only texels x 8..13, rows 0..9 are used.
{
	code: "badge",
	order: 170,
	dressType: "emblem",
	warmth: 0,
	shape: "actailor:entity/garment/base/emblem/blue-seal",
	textureKey: "pendants2",
	textureWidth: 32,
	textureHeight: 32,
	parts: [
		// Badge: an embroidered cloth patch, leather, or a bone/wood/metal plate.
		{ code: "badge", regions: [[8, 0, 13, 4]], materials: ["cloth", "leather", "hard"] },
		// Ribbon: cloth; left empty, the ribbon is not part of the model.
		{ code: "ribbon", regions: [[8, 4, 14, 10]], materials: ["cloth"], elements: ["ribbon"], options: [{ code: "none" }, { code: "ribbon" }] }
	],
	itemType: {
		textures: {
			seraph: { base: "game:block/transparent" },
			pendants2: { base: "game:entity/humanoid/seraphclothes/emblem/emblems1" }
		},
		guiTransform: {
			rotate: false,
			rotation: { x: 174, y: -90, z: 5 },
			origin: { x: 0.5, y: 1.3, z: 0.41 },
			scale: 4.65
		}
	}
}
