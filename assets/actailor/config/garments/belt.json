// Garment recipe (docs/garments.md). Item actailor:garment-belt is generated by scripts/garment-items.py.
// Belt with a premade brass buckle (fixed part, lane/garment-families). Model: our anisotropy-free copy (scripts/garment-shapes.py) of the vanilla sturdy
// belt (waist/sturdy-belt): strap boxes around the lower torso share the top rows of an 8x8-unit texture; the buckle
// (buckle-bottom + its children) and the belt loop sit on their own texels. Texture 16x16 texels = 8x8 shape units.
{
	code: "belt",
	order: 160,
	dressType: "waist",
	warmth: 0,
	shape: "actailor:entity/garment/base/waist/sturdy-belt",
	textureKey: "sturdy-belt",
	textureWidth: 16,
	textureHeight: 16,
	shadingTexture: "game:entity/humanoid/seraphclothes/waist/sturdy-belt",
	parts: [
		// Strap: leather or cloth (a sash).
		{ code: "strap", shade: true, regions: [[0, 0, 16, 5]], materials: ["leather", "cloth"] },
		// Buckle and loop: a FIXED part (example of fixedTexture): premade brass, no sewing slot, always on the model.
		{ code: "buckle", shade: true, regions: [[12, 6, 16, 10]], fixedTexture: "game:block/metal/ingot/brass", fixedColor: "#b8963c" }
	],
	itemType: {
		textures: {
			seraph: { base: "game:block/transparent" },
			"sturdy-belt": { base: "game:entity/humanoid/seraphclothes/waist/sturdy-belt" }
		},
		guiTransform: {
			translation: { x: 0, y: 0, z: 19 },
			rotation: { x: 174, y: -45, z: 23 },
			origin: { x: 0.4, y: 1.15, z: 0.4 },
			scale: 2.85
		}
	}
}
