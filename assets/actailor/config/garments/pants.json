// Garment recipe (docs/garments.md). Item actailor:garment-pants is generated by scripts/garment-items.py.
// Renamed from "trousers" in lane/garment-system: older actailor:garment-trousers stacks stay loadable (legacyItems,
// same part codes), the item is hidden from the creative inventory.
// lane/garment-layers pilot (owner): plain pants and the vanilla clockmaker pants are ONE garment. Model: our copy of
// vanilla lowerbody/clockmaker-pants (= the pants7 boxes + suspender straps + buttons; strap UVs moved below the pants
// layout, scripts/garment-shapes.py); texture 64x88 texels = 32x44 shape units. Layers: waist and legs (0) →
// suspenders (1, may be left off (none option): straps + where they run over the waistband) → buttons (2, may be left off: on the straps, and
// painted on the waistband where the straps button on). An empty layer shows the one below: no suspenders = plain
// pants (buttons, if sewn, sit on the waistband); no buttons = the straps or the waistband.
{
	code: "pants",
	order: 30,
	legacyItems: ["actailor:garment-trousers"],
	dressType: "lowerbody",
	warmth: 2,
	shape: "actailor:entity/garment/base/lowerbody/clockmaker-pants",
	textureKey: "pants",
	textureWidth: 64,
	textureHeight: 88,
	// Vanilla dirty linen trousers + the clockmaker straps block and buttons (generated, garment-shapes.py fallback).
	shadingTexture: "actailor:entity/garment/fallback/lowerbody/clockmaker-pants",
	parts: [
		{ code: "waist", shade: true, regions: [[3, 2, 15, 12], [18, 4, 62, 12], [19, 14, 39, 21]], materials: ["cloth", "leather"] },
		{ code: "leg-right", shade: true, regions: [[3, 17, 31, 67]], materials: ["cloth", "leather"] },
		{ code: "leg-left", shade: true, regions: [[33, 17, 61, 67]], materials: ["cloth", "leather"] },
		// Suspenders (not shaded: its vanilla texels mix the clockmaker straps with the linen waistband, selftest MIXED).
		// The strap elements (moved texels, rows 73-86) + 2-texel stripes over the waistband front (west face
		// [27,5,39,12]) and back (east face [49,5,61,12]) from its top edge down to the button row, at the vanilla buttons.
		{ code: "suspenders", layer: 1, materials: ["leather", "cloth"], elements: ["SuspenderLFrontLower", "SuspenderLFrontUpper"],
			regions: [[23, 73, 25, 74], [22, 74, 28, 80], [39, 79, 48, 80], [18, 80, 28, 81], [38, 80, 58, 81], [17, 81, 31, 83], [38, 81, 61, 82], [39, 82, 61, 83],
				[4, 83, 24, 84], [34, 83, 44, 84], [46, 83, 54, 84], [3, 84, 31, 86], [33, 84, 55, 86], [4, 86, 21, 87], [34, 86, 44, 87],
				[28, 5, 30, 8], [36, 5, 38, 8], [51, 5, 53, 8], [57, 5, 59, 8]], options: [{ code: "none" }, { code: "suspenders" }] },
		// Buttons: the button cuboids (children of the straps) + the 4 button texels vanilla paints on the waistband.
		{ code: "buttons", layer: 2, materials: ["hard"], elements: ["button", "button2", "button3", "button4"],
			regions: [[43, 1, 47, 3], [29, 7, 30, 8], [36, 7, 37, 8], [52, 7, 53, 8], [57, 7, 58, 8]], options: [{ code: "none" }, { code: "buttons" }] }
	],
	itemType: {
		textures: {
			seraph: { base: "game:block/transparent" },
			pants: { base: "actailor:entity/garment/fallback/lowerbody/clockmaker-pants" }
		},
		guiTransform: {
			rotate: false,
			rotation: { x: -173, y: -79, z: 38 },
			origin: { x: 0.5, y: 0.63, z: 0.6 },
			scale: 1.4
		}
	}
}
